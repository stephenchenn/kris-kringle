PORT=3000
ADMIN_SECRET=replace-with-a-random-secret
BASE_URL=http://localhost:3000
DB_PATH=./db.sqlite

# preview writes HTML and JSON emails locally and never contacts an SMTP server.
# Use smtp in production.
EMAIL_MODE=preview
EMAIL_PREVIEW_DIR=.local/emails

# Free Gmail sending: enable 2-Step Verification and create an app password.
# Use the same Gmail address for SMTP_USER and FROM_EMAIL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-google-app-password
FROM_EMAIL="Family Kris Kringle <your-account@gmail.com>"
