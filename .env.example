PORT=3000
ADMIN_SECRET=replace-with-a-random-secret
BASE_URL=http://localhost:3000
DB_PATH=./db.sqlite

# preview writes HTML and JSON emails locally and never contacts an SMTP server.
# Use smtp in production.
EMAIL_MODE=preview
EMAIL_PREVIEW_DIR=.local/emails

# Retain the existing SendGrid integration. Verify FROM_EMAIL in SendGrid.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL="Family Kris Kringle <your-verified-sender@example.com>"
